server {
	listen 80;
	server_name ${SERVER_NAME};
	root /usr/share/nginx/html;

    # Behavior collection
    location /api/beacon {
        proxy_pass http://${BEHAVIOR_SERVER_HOST}:${BEHAVIOR_SERVER_PORT};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 5s;
    }

    # Profile service
    location /profile/ {
        proxy_pass http://${PROFILE_SERVER_HOST}:${PROFILE_SERVER_PORT}/;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $http_host;
        proxy_read_timeout 60s;
    }

    # Recommend service
    location /recommend/ {
        proxy_pass http://${RECOMMEND_SERVER_HOST}:${RECOMMEND_SERVER_PORT}/;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $http_host;
        proxy_read_timeout 30s;
    }

    # AI Agent service
    location /agent/ {
        proxy_pass http://${AGENT_SERVER_HOST}:${AGENT_SERVER_PORT}/;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $http_host;
        proxy_read_timeout 60s;
        proxy_buffering off;
    }

    # Main backend API
    location /api{
        proxy_pass http://${BACKEND_SERVER_HOST}:${BACKEND_SERVER_PORT};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 512M;
    }

    location ~ .*\.(js|json|css)$ {
        gzip on;
        gzip_static on;
        gzip_min_length 1k;
        gzip_http_version 1.1;
        gzip_comp_level 9;
        gzip_types text/css application/javascript application/json;
        root /usr/share/nginx/html;
    }

    location / {
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    location ^~ /scrollBoard {
        alias /usr/share/nginx/scrollBoard;
        try_files $uri $uri/ /index.html;
        index index.html index.htm;
    }
}
